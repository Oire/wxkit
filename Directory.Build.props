<Project>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest</AnalysisLevel>
		<ArtifactsRoot>$(MSBuildThisFileDirectory)artifacts</ArtifactsRoot>
		<WxKitNativeRoot>$(ArtifactsRoot)/native</WxKitNativeRoot>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.1.0-preview.1</Version>
		<Authors>Quin Gillespie</Authors>
		<Copyright>Copyright (c) Quin Gillespie</Copyright>
		<NeutralLanguage>en-US</NeutralLanguage>
		<RepositoryUrl>https://github.com/trypsynth/wxkit</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
	</PropertyGroup>

	<!-- A CI build is deterministic, with paths that do not name the machine that built it, so its symbols point at the repository's sources through Source Link. -->
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

</Project>
