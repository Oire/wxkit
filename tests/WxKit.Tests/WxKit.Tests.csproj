<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- wxWidgets has to own the main thread, so Program.cs is the entry point instead of xUnit's. -->
		<XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
		<!-- The tests run as the machine's own system and architecture, so they load the native build for it. -->
		<_WxKitTestSystem Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_WxKitTestSystem>
		<_WxKitTestSystem Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_WxKitTestSystem>
		<_WxKitTestSystem Condition="'$(_WxKitTestSystem)' == ''">win</_WxKitTestSystem>
		<_WxKitTestArchitecture Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</_WxKitTestArchitecture>
		<_WxKitTestArchitecture Condition="'$(_WxKitTestArchitecture)' == ''">x64</_WxKitTestArchitecture>
		<WxKitTestRuntime Condition="'$(WxKitTestRuntime)' == ''">$(_WxKitTestSystem)-$(_WxKitTestArchitecture)</WxKitTestRuntime>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\WxKit\WxKit.csproj" />
	</ItemGroup>

	<!-- The tests run as an application would, with WxKit's manifest and Timer alias. -->
	<Import Project="..\..\src\WxKit\build\WxKit.targets" />

	<ItemGroup>
		<None Include="$(WxKitNativeRoot)/$(WxKitTestRuntime)/shared/*.dll;$(WxKitNativeRoot)/$(WxKitTestRuntime)/shared/*.dylib;$(WxKitNativeRoot)/$(WxKitTestRuntime)/shared/*.so" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
