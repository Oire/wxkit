<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>WxKit</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>WxKit</PackageId>
		<Description>.NET bindings to wxWidgets, for native desktop applications. Links wxWidgets into Native AOT executables.</Description>
		<PackageTags>wxwidgets;gui;desktop;native;native-aot;accessibility</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/trypsynth/wxkit</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../../README.md;../../LICENSE" Pack="true" PackagePath="/" />
		<None Include="build/WxKit.targets;build/wxkit.manifest;build/WxKitMergeResources.cs" Pack="true" PackagePath="buildTransitive/" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WxKit.Tests" />
	</ItemGroup>

	<!-- The merge task is compiled by MSBuild in the consuming build, not as part of WxKit. -->
	<ItemGroup>
		<Compile Remove="build/**" />
	</ItemGroup>

</Project>
